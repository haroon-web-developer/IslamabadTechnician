rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidService(data) {
      return data.keys().hasAll(['title', 'description', 'price', 'rating', 'slug']) &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.price is number && 
             data.rating is number &&
             data.slug is string && data.slug.size() <= 100 &&
             (data.get('categoryId', '') is string) &&
             (data.get('discountPrice', 0) is number) &&
             (data.get('isTrendy', false) is bool) &&
             (data.get('isSeasonal', false) is bool) &&
             (data.get('showOnHome', true) is bool) &&
             (data.get('imageUrl', '') is string);
    }
    
    function isValidCategory(data) {
      return data.keys().hasAll(['title', 'description', 'icon', 'slug']) &&
             data.title is string && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.icon is string &&
             data.slug is string && data.slug.size() <= 100;
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isSignedIn() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isSignedIn() && isValidId(categoryId);
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(serviceId) && isValidService(incoming());
      allow update: if isSignedIn() && isValidId(serviceId) && isValidService(incoming());
      allow delete: if isSignedIn() && isValidId(serviceId);
    }
  }
}
